BOOK_MODEL=openai/gpt-4.1-nano
ADMIN_EMAILS=

# Comptes, base de données et médias privés Supabase.
# La clé publishable peut être exposée au navigateur; la clé secret ne le doit jamais.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_MEDIA_BUCKET=project-media

# Courriels transactionnels (activation ultérieure avec le domaine validé).
RESEND_API_KEY=
EMAIL_FROM=

# Paiements volontairement inactifs tant que le compte d'Emilie n'est pas relié.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Devis uniquement. Aucun endpoint de commande fournisseur actif.
PRODIGI_API_KEY=
PRODIGI_API_ENV=production
