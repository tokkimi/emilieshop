BOOK_MODEL=openai/gpt-4.1-nano
ADMIN_EMAILS=

# Comptes, base de données et médias privés Supabase.
# La clé publishable peut être exposée au navigateur; la clé secret ne le doit jamais.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_MEDIA_BUCKET=project-media

# Courriels transactionnels (activation ultérieure avec le domaine validé).
RESEND_API_KEY=
EMAIL_FROM=

# Paiements volontairement inactifs tant que le compte d'Emilie n'est pas relié.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Lulu Print API. Garder sandbox jusqu'à la validation complète du flux.
LULU_API_ENV=sandbox
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
LULU_POD_PACKAGE_ID=0850X0850.FC.PRE.CW.080CW444.MXX
LULU_ORDERS_ENABLED=false
LULU_ORDER_GATE_KEY=
# Courriel de contact transmis avec les commandes Lulu (repli si absent de la commande).
LULU_CONTACT_EMAIL=
# Jeton optionnel pour lancer le diagnostic de connexion Lulu par appel machine.
# Laisser vide : l'administration connectée peut toujours lancer le diagnostic.
LULU_DIAGNOSTICS_TOKEN=
